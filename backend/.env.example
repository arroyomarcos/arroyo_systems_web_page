# Example environment file for the backend.
# Copy this to .env and fill in real values. NEVER commit .env to git.

# ---------- MongoDB ----------
# For local development: mongodb://localhost:27017
# For production (MongoDB Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL="mongodb://localhost:27017"

# Name of the MongoDB database
DB_NAME="arroyo_systems"

# ---------- CORS ----------
# Comma-separated list of allowed origins, or "*" for permissive.
# Production example: https://arroyo-systems.com,https://www.arroyo-systems.com
CORS_ORIGINS="*"

# ---------- Auth ----------
# Generate a strong random JWT secret (>= 48 random bytes):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="change-me-generate-a-strong-random-value"

# Admin user credentials. The backend syncs this password on startup.
ADMIN_USERNAME="arroyo_admin"
ADMIN_PASSWORD="change-me-use-a-strong-password"

# ---------- Privacy / anti-spam ----------
PRIVACY_POLICY_VERSION="v1.0"
# Keep true in production so direct API submissions also require consent.
REQUIRE_PRIVACY_ACCEPTANCE="true"
# Optional Cloudflare Turnstile secret key. If set, /contact requires a valid token.
TURNSTILE_SECRET_KEY=""

# ---------- Abuse protection ----------
RATE_LIMIT_CONTACT_MAX="5"
RATE_LIMIT_CONTACT_WINDOW_SECONDS="60"
# Random secret used to hash IPs before storage.
IP_HASH_SALT="change-me-generate-another-strong-random-value"

# ---------- Email notifications ----------
# Configure these in production to receive an email when a contact request arrives.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="contact@arroyo-systems.com"
CONTACT_NOTIFICATION_TO="contact@arroyo-systems.com"
EMAIL_SEND_TIMEOUT_SECONDS="5"

# Preferred on Render because it sends over HTTPS instead of SMTP ports.
RESEND_API_KEY=""
RESEND_FROM="Arroyo Systems <notifications@arroyo-systems.com>"
RESEND_FALLBACK_FROM="Arroyo Systems <onboarding@resend.dev>"

# ---------- Stripe ----------
# Secret key from https://dashboard.stripe.com/apikeys (use sk_test_... while developing).
STRIPE_SECRET_KEY=""
# Signing secret for the webhook endpoint, from the Stripe CLI (`stripe listen`) or
# the Dashboard webhook config (whsec_...). Required to verify incoming webhook events.
STRIPE_WEBHOOK_SECRET=""
# Where Stripe redirects the client after a successful/cancelled Checkout.
# {CHECKOUT_SESSION_ID} is replaced by Stripe itself - keep it literal.
STRIPE_SUCCESS_URL="https://arroyo-systems.com/checkout/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CANCEL_URL="https://arroyo-systems.com/checkout/cancel"
STRIPE_CURRENCY="eur"

# ---------- Frontend / links ----------
# Public URL of the frontend, used to build client-facing quote/contract links in emails.
FRONTEND_URL="https://arroyo-systems.com"

# ---------- Service contract (constant across all generated contracts) ----------
CONTRACT_PROVIDER_NIF=""
# Shown in Clauses 9/10 as the professional liability insurance coverage. Leave as "a
# determinar" until a real policy exists - never state a coverage figure that isn't real.
CONTRACT_LIABILITY_TEXT="a determinar"
CONTRACT_JURISDICTION_CITY="Madrid"

# ---------- DocuSign (JWT Grant / server-to-server) ----------
# Public HTTPS URL of THIS backend, used as the DocuSign Connect webhook target.
BACKEND_PUBLIC_URL=""
# Integration Key (Client ID) from DocuSign's "Apps and Keys" console.
DOCUSIGN_INTEGRATION_KEY=""
# Impersonated DocuSign user GUID (the account member whose signature authority is used).
DOCUSIGN_USER_ID=""
# Base64-encoded RSA private key PEM, paired with the public key uploaded to the DocuSign app.
# Generate with: openssl genrsa -out private.pem 2048 && base64 -w0 private.pem
DOCUSIGN_PRIVATE_KEY_B64=""
# account-d.docusign.com for the sandbox, account.docusign.com for production.
DOCUSIGN_AUTH_HOST="account-d.docusign.com"
# Secret used to verify DocuSign Connect webhook HMAC signatures. DocuSign GENERATES this
# value itself and ignores any value you send - register a key once per account with:
#   POST {base_uri}/restapi/v2.1/accounts/{account_id}/connect/secret
# and copy the value it returns into "secrets" in the response. Needed again for production
# Go-Live (separate DocuSign account = separate secret).
DOCUSIGN_HMAC_KEY=""
